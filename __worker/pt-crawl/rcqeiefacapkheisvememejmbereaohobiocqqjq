<div class="mw-heading mw-heading5"><h5 id="Konformáció"><span id="Konform.C3.A1ci.C3.B3"></span>Konformáció</h5><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Szerves_k%C3%A9mia&amp;action=edit&amp;section=5" title="Szakasz szerkesztése: Konformáció"><span>szerkesztés</span></a><span class="mw-editsection-bracket">]</span></span></div>
