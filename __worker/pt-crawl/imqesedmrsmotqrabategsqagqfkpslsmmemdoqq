          <mtext>C</mtext>
          <mo>+</mo>
          <mtext>D</mtext>
        </mrow>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle {\ce {A + B -&gt; C + D}}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/abdcffe68f2382d1b3b8d7627091fc2e6e7d2f32" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.505ex; width:17.619ex; height:2.343ex;" alt="{\displaystyle {\ce {A + B -&gt; C + D}}}"></span>,</dd></dl>
<p>then
</p>
<dl><dd><span class="mwe-math-element"><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\text{Rate}}=k\cdot [{\ce {A}}]^{n}\cdot [{\ce {B}}]^{m}}">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
