        <mo stretchy="false">[</mo>
        <mrow class="MJX-TeXAtom-ORD">
          <mtext>A</mtext>
        </mrow>
        <msup>
          <mo stretchy="false">]</mo>
          <mrow class="MJX-TeXAtom-ORD">
            <mi>n</mi>
          </mrow>
        </msup>
        <mo>&#x22C5;<!-- ⋅ --></mo>
        <mo stretchy="false">[</mo>
        <mrow class="MJX-TeXAtom-ORD">
