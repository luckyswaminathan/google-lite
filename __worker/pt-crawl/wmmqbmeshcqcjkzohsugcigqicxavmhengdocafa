<div class="mw-heading mw-heading2"><h2 id="Condensed_formulas">Condensed formulas</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Structural_formula&amp;action=edit&amp;section=8" title="Edit section: Condensed formulas"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
