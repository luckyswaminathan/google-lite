<th class="cot-header-mainspace" style="; font-size:87%; padding:0.2em 0.3em; text-align:center;"><div style="font-size:115%;margin:0 4em">Royal Danish Army<sup id="cite_ref-FOOTNOTEPettibone201490-91_39-0" class="reference"><a href="#cite_note-FOOTNOTEPettibone201490-91-39"><span class="cite-bracket">&#91;</span>39<span class="cite-bracket">&#93;</span></a></sup><sup id="cite_ref-FOOTNOTEVolden20079_40-0" class="reference"><a href="#cite_note-FOOTNOTEVolden20079-40"><span class="cite-bracket">&#91;</span>40<span class="cite-bracket">&#93;</span></a></sup><sup id="cite_ref-FOOTNOTEJensen202019_41-0" class="reference"><a href="#cite_note-FOOTNOTEJensen202019-41"><span class="cite-bracket">&#91;</span>41<span class="cite-bracket">&#93;</span></a></sup> </div>
